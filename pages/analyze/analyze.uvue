<template>
  <view class="container">
    <!-- 顶部标题栏 -->
    <view class="header">
      <text class="back" @click="goBack">←</text>
      <text class="title">财务分析</text>
      <text class="subtitle">深度分析您的财务状况</text>
    </view>

    <!-- 时间选择器 -->
    <view class="time-selector">
      <view class="tabs">
        <view
          v-for="tab in timeTabs"
          :key="tab.value"
          :class="['tab', activeTimeTab === tab.value ? 'active' : '']"
          @click="switchTimeTab(tab.value)"
        >
          {{ tab.label }}
        </view>
      </view>
    </view>

    <!-- 总览卡片 -->
    <view class="overview-card">
      <view class="overview-header">
        <text class="overview-title">财务总览</text>
        <text class="overview-period">{{ getPeriodText() }}</text>
      </view>
      <view class="overview-grid">
        <view class="overview-item">
          <text class="overview-label">总收入</text>
          <text class="overview-value income">¥{{ formatAmount(totalStats.income) }}</text>
          <text class="overview-count">{{ totalStats.incomeCount }}笔</text>
        </view>
        <view class="overview-item">
          <text class="overview-label">总支出</text>
          <text class="overview-value expense">¥{{ formatAmount(totalStats.expense) }}</text>
          <text class="overview-count">{{ totalStats.expenseCount }}笔</text>
        </view>
        <view class="overview-item">
          <text class="overview-label">净收入</text>
          <text :class="['overview-value', totalStats.netIncome >= 0 ? 'income' : 'expense']">
            ¥{{ formatAmount(totalStats.netIncome) }}
          </text>
          <text class="overview-count">{{ totalStats.savingsRate }}%</text>
        </view>
        <view class="overview-item">
          <text class="overview-label">总资产</text>
          <text :class="['overview-value', totalStats.totalAssets >= 0 ? 'income' : 'expense']">
            ¥{{ formatAmount(totalStats.totalAssets) }}
          </text>
          <text class="overview-count">累计</text>
        </view>
      </view>
    </view>

    <!-- 收支趋势图 -->
    <view class="chart-card">
      <view class="chart-header">
        <text class="chart-title">收支趋势</text>
        <text class="chart-subtitle">{{ getPeriodText() }}收支变化</text>
      </view>
      <view class="chart-container">
        <qiun-data-charts 
          type="column"
          :opts="columnOpts"
          :chartData="trendChartData"
        />
      </view>
    </view>

    <!-- 支出分类饼图 -->
    <view class="chart-card">
      <view class="chart-header">
        <text class="chart-title">支出分类</text>
        <text class="chart-subtitle">按分类统计支出</text>
      </view>
      <view class="chart-container">
        <qiun-data-charts 
          type="pie"
          :opts="pieOpts"
          :chartData="categoryChartData"
        />
      </view>
    </view>

    <!-- 分类排行榜 -->
    <view class="ranking-card">
      <view class="ranking-header">
        <text class="ranking-title">支出排行榜</text>
        <view class="ranking-tabs">
          <view
            v-for="tab in rankingTabs"
            :key="tab.value"
            :class="['ranking-tab', activeRankingTab === tab.value ? 'active' : '']"
            @click="switchRankingTab(tab.value)"
          >
            {{ tab.label }}
          </view>
        </view>
      </view>
      <view class="ranking-list">
        <view 
          v-for="(item, index) in rankingList" 
          :key="item.id"
          class="ranking-item"
        >
          <view class="ranking-rank">{{ index + 1 }}</view>
          <view class="ranking-info">
            <text class="ranking-name">{{ item.categoryName }}</text>
            <text class="ranking-count">{{ item.count }}笔交易</text>
          </view>
          <text class="ranking-amount">¥{{ formatAmount(item.amount) }}</text>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view v-if="isLoading" class="loading-overlay">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted, computed } from 'vue'
import { 
  getUserStatistics, 
  getTotalStatistics,
  getCategoryRanking 
} from '../../common/api/analyze'

// 时间选择器
const timeTabs = [
  { label: '本周', value: 'week' },
  { label: '本月', value: 'month' },
  { label: '本年', value: 'year' }
]
const activeTimeTab = ref('month')

// 排行榜选择器
const rankingTabs = [
  { label: '支出', value: 'expense' },
  { label: '收入', value: 'income' }
]
const activeRankingTab = ref('expense')

// 数据状态
const isLoading = ref(false)
const totalStats = ref({
  income: 0,
  expense: 0,
  netIncome: 0,
  totalAssets: 0,
  incomeCount: 0,
  expenseCount: 0,
  savingsRate: 0
})

const trendChartData = ref({})
const categoryChartData = ref({})
const rankingList = ref([])

// 图表配置
const columnOpts = {
  color: ["#91CB74", "#EE6666"],
  padding: [15, 15, 15, 15],
  legend: {
    show: true,
    position: "bottom",
    fontSize: 13,
    fontColor: "#666666"
  },
  xAxis: {
    disableGrid: true,
    fontColor: "#666666",
    fontSize: 12
  },
  yAxis: {
    data: [{ min: 0 }],
    disabled: false,
    disableGrid: false,
    splitNumber: 5,
    gridType: "solid",
    dashLength: 8,
    gridColor: "#CCCCCC",
    padding: 10,
    showTitle: false
  },
  extra: {
    column: {
      type: "group",
      width: 30,
      seriesGap: 2,
      categoryGap: 3
    }
  }
}

const pieOpts = {
  color: ["#1890FF", "#91CB74", "#FAC858", "#EE6666", "#73C0DE", "#3CA272", "#FC8452", "#9A60B4"],
  padding: [15, 15, 15, 15],
  legend: {
    show: true,
    position: "bottom",
    fontSize: 12,
    fontColor: "#666666"
  },
  extra: {
    pie: {
      activeOpacity: 0.5,
      activeRadius: 10,
      offsetAngle: 0,
      labelWidth: 15,
      border: true,
      borderWidth: 3,
      borderColor: "#FFFFFF"
    }
  }
}

// 方法
function goBack() {
  uni.navigateBack()
}

function switchTimeTab(tab: string) {
  activeTimeTab.value = tab
  loadData()
}

function switchRankingTab(tab: string) {
  activeRankingTab.value = tab
  loadRankingData()
}

function getPeriodText() {
  const now = new Date()
  const year = now.getFullYear()
  const month = now.getMonth() + 1
  
  switch (activeTimeTab.value) {
    case 'week':
      return `${year}年第${Math.ceil((now.getTime() - new Date(year, 0, 1).getTime()) / (7 * 24 * 60 * 60 * 1000) + 1)}周`
    case 'month':
      return `${year}年${month}月`
    case 'year':
      return `${year}年`
    default:
      return ''
  }
}

function formatAmount(amount: number): string {
  return (amount / 100).toFixed(2)
}

async function loadData() {
  if (isLoading.value) return
  
  isLoading.value = true
  
  try {
    // 并行加载数据
    const [statsResponse, totalResponse] = await Promise.all([
      getUserStatistics(activeTimeTab.value),
      getTotalStatistics()
    ])
    
    console.log('统计数据响应:', statsResponse)
    console.log('总统计数据响应:', totalResponse)
    
    // 处理统计数据
    if (statsResponse?.data?.list && statsResponse.data.list.length > 0) {
      processTrendData(statsResponse.data.list)
    }
    
    // 处理总统计数据
    if (totalResponse?.data) {
      processTotalStats(totalResponse.data)
    }
    
    // 加载分类排行榜
    await loadRankingData()
    
  } catch (error) {
    console.error('加载数据失败:', error)
    uni.showToast({
      title: '加载失败，请重试',
      icon: 'none'
    })
  } finally {
    isLoading.value = false
  }
}

function processTrendData(statsList: any[]) {
  const categories = []
  const incomeData = []
  const expenseData = []
  
  // 按时间排序
  const sortedStats = statsList.sort((a, b) => 
    new Date(a.start_time).getTime() - new Date(b.start_time).getTime()
  )
  
  sortedStats.forEach(stat => {
    const date = new Date(stat.start_time)
    let label = ''
    
    switch (activeTimeTab.value) {
      case 'week':
        label = `第${Math.ceil((date.getTime() - new Date(date.getFullYear(), 0, 1).getTime()) / (7 * 24 * 60 * 60 * 1000) + 1)}周`
        break
      case 'month':
        label = `${date.getMonth() + 1}月`
        break
      case 'year':
        label = `${date.getFullYear()}年`
        break
    }
    
    categories.push(label)
    incomeData.push(stat.statistics.income.amount / 100)
    expenseData.push(stat.statistics.expense.amount / 100)
  })
  
  trendChartData.value = {
    categories,
    series: [
      {
        name: "收入",
        data: incomeData
      },
      {
        name: "支出",
        data: expenseData
      }
    ]
  }
}

function processTotalStats(data: any) {
  const income = data.income || { amount: 0, count: 0 }
  const expense = data.expense || { amount: 0, count: 0 }
  const totalAssets = data.total_assets || 0
  
  const incomeAmount = income.amount
  const expenseAmount = expense.amount
  const netIncome = incomeAmount - expenseAmount
  const savingsRate = incomeAmount > 0 ? Math.round((netIncome / incomeAmount) * 100) : 0
  
  totalStats.value = {
    income: incomeAmount,
    expense: expenseAmount,
    netIncome,
    totalAssets,
    incomeCount: income.count,
    expenseCount: expense.count,
    savingsRate
  }
}

async function loadRankingData() {
  try {
    const response = await getCategoryRanking({
      type: activeTimeTab.value,
      income_expense: activeRankingTab.value,
      limit: 10
    })
    
    console.log('分类排行榜响应:', response)
    
    if (response?.data?.list) {
      rankingList.value = response.data.list.map(item => ({
        id: item.category?.id || 0,
        categoryName: item.category?.name || '未知分类',
        amount: item.amount,
        count: item.count
      }))
      
      // 更新饼图数据
      updateCategoryChart()
    }
  } catch (error) {
    console.error('加载排行榜失败:', error)
  }
}

function updateCategoryChart() {
  if (activeRankingTab.value === 'expense' && rankingList.value.length > 0) {
    const series = rankingList.value.slice(0, 8).map(item => ({
      name: item.categoryName,
      data: item.amount / 100
    }))
    
    categoryChartData.value = { series }
  }
}

onMounted(() => {
  loadData()
})
</script>

