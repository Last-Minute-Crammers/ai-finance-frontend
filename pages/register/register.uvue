<template>
  <view class="register-container">
    <view class="form-item">
      <input type="text" v-model="username" placeholder="请输入用户名" />
    </view>
    <view class="form-item">
      <input type="password" v-model="password" placeholder="请输入密码" />
    </view>
    <view class="form-item">
      <input type="password" v-model="confirmPassword" placeholder="请确认密码" />
    </view>
    <button class="register-btn" @click="register">注册</button>
    <view class="login-link" @click="goToLogin">已有账号？去登录</view>
  </view>
</template>

<script setup lang="ts">
import { ref } from 'vue'

const username = ref('')
const password = ref('')
const confirmPassword = ref('')

// 注册操作
async function register() {
  // 输入验证
  if (!username.value || !password.value || !confirmPassword.value) {
    uni.showToast({
      title: '请填写完整信息',
      icon: 'none',
    })
    return
  }

  if (password.value !== confirmPassword.value) {
    uni.showToast({
      title: '两次密码不一致',
      icon: 'none',
    })
    return
  }

  // 从本地存储获取已注册用户
  const registeredUsers = uni.getStorageSync('registered_users') || []

  // 检查用户名是否已存在
  if (registeredUsers.some((u: any) => u.username === username.value)) {
    uni.showToast({
      title: '用户名已存在',
      icon: 'none',
    })
    return
  }

  // 创建新用户
  const newUser = {
    username: username.value,
    password: password.value,
    registeredAt: new Date().toISOString(),
  }

  // 保存用户信息
  registeredUsers.push(newUser)
  uni.setStorageSync('registered_users', registeredUsers)

  // 显示注册成功提示
  uni.showToast({
    title: '注册成功',
    icon: 'success',
    mask: true,
    duration: 1500,
  })

  // 等待提示显示完毕后跳转
  setTimeout(() => {
    uni.navigateTo({
      url: '/pages/login/login',
    })
  }, 1500)
}

// 跳转到登录页
function goToLogin() {
  uni.navigateTo({
    url: '/pages/login/login',
  })
}
</script>

<style>
.register-container {
  padding: 20px;
}

.form-item {
  margin-bottom: 20px;
}

.form-item input {
  width: 100%;
  height: 40px;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 0 10px;
}

.register-btn {
  width: 100%;
  height: 40px;
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 4px;
  margin: 20px 0;
}

.login-link {
  text-align: center;
  color: #007aff;
  font-size: 14px;
}
</style>
