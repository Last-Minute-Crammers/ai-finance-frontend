<template>
  <view class="transaction-container">
    <!-- 顶部标题栏 -->
    <view class="header">
      <text class="back-btn" @click="goBack">←</text>
      <text class="header-title">记账</text>
      <text class="header-sub">记录您的每一笔收支</text>
    </view>

    <!-- 支出 / 收入 切换 -->
    <view class="type-toggle">
      <view class="type-btn" :class="{ active: type === '支出' }" @click="changeType('支出')">支出</view>
      <view class="type-btn" :class="{ active: type === '收入' }" @click="changeType('收入')">收入</view>
    </view>

    <!-- 金额输入 -->
    <view class="amount-card">
      <view class="amount-line">
        <text class="currency">¥</text>
        <input class="amount-input" type="digit" v-model="amount" placeholder="0.00" />
      </view>

      <!-- 分类 -->
      <text class="section-label">选择分类</text>
      <view class="category-grid">
        <view
          v-for="(item, index) in categories"
          :key="index"
          class="category-item"
          :class="{ selected: selectedCategory === item.name }"
          @click="selectedCategory = item.name"
        >
          <text class="emoji">{{ item.icon }}</text>
          <text class="name">{{ item.name }}</text>
        </view>
      </view>

      <!-- 日期 -->
      <view class="date-row">
        <text class="date-label">日期</text>
        <text class="date-value">今天，{{ date }}</text>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-btn-wrapper">
      <button class="save-btn" @click="submitTransaction" :disabled="loading">
        {{ loading ? '保存中...' : '保存记录' }}
      </button>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { createTransaction } from '../../common/api/transaction' // 修正import路径

const type = ref('支出')
const amount = ref('')
const selectedCategory = ref('餐饮')
const date = ref('')
const loading = ref(false)
const categories = ref([
  { name: '餐饮', icon: '🍔', id: 1 },
  { name: '购物', icon: '🛒', id: 2 },
  { name: '交通', icon: '🚗', id: 3 },
  { name: '住房', icon: '🏠', id: 4 },
  { name: '娱乐', icon: '🎬', id: 5 },
  { name: '数码', icon: '📱', id: 6 },
  { name: '服饰', icon: '👗', id: 7 },
  { name: '其他', icon: '➕', id: 8 }
])

// 页面加载时获取当前日期
onMounted(async () => {
  date.value = formatDate(new Date())
})

function goBack() {
  uni.navigateBack()
}

function changeType(newType: string) {
  type.value = newType
}

function formatDate(date: Date) {
  const y = date.getFullYear()
  const m = (date.getMonth() + 1).toString().padStart(2, '0')
  const d = date.getDate().toString().padStart(2, '0')
  return `${y}年${m}月${d}日`
}

async function submitTransaction() {
  try {
    loading.value = true

    // 输入验证
    if (!amount.value) {
      uni.showToast({ title: '请输入金额', icon: 'none' })
      return
    }

    const amountNum = parseFloat(amount.value)
    if (isNaN(amountNum) || amountNum <= 0) {
      uni.showToast({ title: '请输入有效的正数金额', icon: 'none' })
      return
    }

    const selectedCategoryData = categories.value.find(c => c.name === selectedCategory.value)
    if (!selectedCategoryData) {
      uni.showToast({ title: '请选择分类', icon: 'none' })
      return
    }

    const amountInCents = Math.round(amountNum * 100) // 转换为分

    // 准备交易数据 - 修复类型匹配问题
    const transactionData: {
      categoryId: number;
      incomeExpense: 'expense' | 'income';
      amount: number;
      remark: string;
      tradeTime: string;
    } = {
      categoryId: selectedCategoryData.id,
      incomeExpense: type.value === '支出' ? 'expense' : 'income',
      amount: amountInCents,
      remark: '',
      tradeTime: new Date().toISOString()
    }

    console.log('发送交易数据:', transactionData);

    // 调用后端API
    const response = await createTransaction(transactionData)
    
    console.log('后端响应:', response);
    
    // 修复响应格式检查 - 使用类型安全的方式
    const isSuccess = (
      response.code === 200 || 
      (response as any).Code === 200 || 
      (response.data && !(response as any).error) || 
      (response as any).Msg === 'success'
    );
    
    if (isSuccess) {
      amount.value = ''
      uni.showToast({ 
        title: '记录已保存',
        icon: 'success',
        mask: true,
        duration: 1500
      })
      setTimeout(() => {
        uni.navigateBack()
      }, 1500)
    } else {
      const errorMessage = (
        response.message || 
        (response as any).Msg || 
        (response as any).error || 
        '保存失败'
      );
      throw new Error(errorMessage);
    }

  } catch (error) {
    console.error('保存失败:', error)
    
    // 安全地处理错误信息
    const errorMessage = (error && typeof error === 'object' && 'message' in error) 
      ? String(error.message) 
      : String(error);
    
    uni.showToast({
      title: `保存失败: ${errorMessage}`,
      icon: 'none',
      duration: 2000
    })
  } finally {
    loading.value = false
  }
}
</script>

