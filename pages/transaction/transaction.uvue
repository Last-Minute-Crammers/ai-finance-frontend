<template>
  <view class="transaction-container">
    <!-- 顶部标题栏 -->
    <view class="header">
      <text class="back-btn" @click="goBack">←</text>
      <text class="header-title">记账</text>
      <text class="header-sub">记录您的每一笔收支</text>
    </view>

    <!-- 支出 / 收入 切换 -->
    <view class="type-toggle">
      <view class="type-btn" :class="{ active: type === '支出' }" @click="changeType('支出')">支出</view>
      <view class="type-btn" :class="{ active: type === '收入' }" @click="changeType('收入')">收入</view>
    </view>

    <!-- 金额输入 -->
    <view class="amount-card">
      <view class="amount-line">
        <text class="currency">¥</text>
        <input class="amount-input" type="digit" v-model="amount" placeholder="0.00" />
      </view>

      <!-- 分类 -->
      <text class="section-label">选择分类</text>
      <view class="category-grid">
        <view
          v-for="(item, index) in categories"
          :key="index"
          class="category-item"
          :class="{ selected: selectedCategory === item.name }"
          @click="selectedCategory = item.name"
        >
          <text class="emoji">{{ item.icon }}</text>
          <text class="name">{{ item.name }}</text>
        </view>
      </view>

      <!-- 日期 -->
      <view class="date-row">
        <text class="date-label">日期</text>
        <text class="date-value">今天，{{ date }}</text>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-btn-wrapper">
      <button class="save-btn" @click="submitTransaction">保存记录</button>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'

const type = ref('支出')
const amount = ref('')
const selectedCategory = ref('餐饮')
const date = ref('')
const categories = ref([
  { name: '餐饮', icon: '🍔', id: 1 },
  { name: '购物', icon: '🛒', id: 2 },
  { name: '交通', icon: '🚗', id: 3 },
  { name: '住房', icon: '🏠', id: 4 },
  { name: '娱乐', icon: '🎬', id: 5 },
  { name: '数码', icon: '📱', id: 6 },
  { name: '服饰', icon: '👗', id: 7 },
  { name: '其他', icon: '➕', id: 8 }
])

// 页面加载时获取当前日期
onMounted(async () => {
  date.value = formatDate(new Date())
})

// 获取本地存储的交易记录
function getLocalTransactions() {
  const transactions = uni.getStorageSync('transactions') || '[]'
  return JSON.parse(transactions)
}

// 保存交易记录到本地存储
function saveTransaction(transaction: any) {
  const transactions = getLocalTransactions()
  transactions.push(transaction)
  uni.setStorageSync('transactions', JSON.stringify(transactions))
}

// 根据分类名称返回对应的图标
function getIconForCategory(name: string) {
  const iconMap: { [key: string]: string } = {
    '餐饮': '🍔',
    '购物': '🛒',
    '交通': '🚗',
    '住房': '🏠',
    '娱乐': '🎬',
    '数码': '📱',
    '服饰': '👗',
  }
  return iconMap[name] || '➕'
}

function goBack() {
  uni.navigateBack()
}

function changeType(newType: string) {
  type.value = newType
}

function formatDate(date: Date) {
  const y = date.getFullYear()
  const m = (date.getMonth() + 1).toString().padStart(2, '0')
  const d = date.getDate().toString().padStart(2, '0')
  return `${y}年${m}月${d}日`
}

async function submitTransaction() {
  try {
    console.log('开始保存交易...')
    
    // 输入验证
    if (!amount.value) {
      uni.showToast({ title: '请输入金额', icon: 'none' })
      return
    }

    const amountNum = parseFloat(amount.value)
    if (isNaN(amountNum) || amountNum <= 0) {
      uni.showToast({ title: '请输入有效的正数金额', icon: 'none' })
      return
    }

    const selectedCategoryData = categories.value.find(c => c.name === selectedCategory.value)
    if (!selectedCategoryData) {
      uni.showToast({ title: '请选择分类', icon: 'none' })
      return
    }

    const amountInCents = Math.round(amountNum * 100) // 转换为分

    // 准备交易数据
    const transaction = {
      id: Date.now(), // 使用时间戳作为唯一ID
      amount: amountInCents,
      categoryId: selectedCategoryData.id,
      categoryName: selectedCategoryData.name,
      type: type.value === '支出' ? 'expense' : 'income',
      remark: '',
      tradeTime: new Date().toISOString(),
      createTime: new Date().toISOString()
    }

    // 保存到本地存储
    saveTransaction(transaction)

    // 清空表单
    amount.value = ''
      // 保存前先获取现有数据
      const existingTransactions = getLocalTransactions()
      console.log('现有交易记录:', existingTransactions)
      
      // 添加新交易到现有数据
      existingTransactions.push(transaction)
  
      // 保存更新后的数据到本地存储
      uni.setStorageSync('transactions', JSON.stringify(existingTransactions))
      console.log('保存后的所有交易:', existingTransactions)
  
      // 显示成功提示
      uni.showToast({ 
        title: '记录已保存',
        icon: 'success',
        mask: true,
        duration: 1500
      })
  
      // 等待提示显示完毕后返回
      setTimeout(() => {
        uni.navigateBack()
      }, 1500)

  } catch (error) {
    console.error('保存失败:', error)
    uni.showToast({
      title: '保存失败，请重试',
      icon: 'none',
      duration: 2000
    })
  }
}
</script>

<style>
.transaction-container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 10%;
}

.header {
  background: linear-gradient(to right, #4e54c8, #8f94fb);
  padding: 80rpx 30rpx 40rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  text-align: center;
  position: relative;
}

.back-btn {
  position: absolute;
  left: 30rpx;
  top: 80rpx;
  font-size: 36rpx;
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.header-sub {
  font-size: 24rpx;
  color: white;
  margin-top: 10rpx;
}

.type-toggle {
  display: flex;
  justify-content: center;
  background: #e0e3f0;
  border-radius: 40rpx;
  margin: 30rpx auto 20rpx;
  width: 60%;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #555;
  font-weight: bold;
  border-radius: 40rpx;
}

.type-btn.active {
  background: white;
  color: #4e54c8;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.amount-card {
  background: #fff;
  margin: 0 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.amount-line {
  display: flex;
  align-items: center;
  font-size: 44rpx;
  margin-bottom: 20rpx;
}

.currency {
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 44rpx;
}

.section-label {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.category-item {
  background: #f4f4f4;
  border-radius: 16rpx;
  padding: 20rpx 0;
  text-align: center;
}

.category-item.selected {
  background: #e0e3ff;
  border: 2rpx solid #4e54c8;
}

.emoji {
  font-size: 36rpx;
  margin-bottom: 10rpx;
  display: block;
}

.name {
  font-size: 22rpx;
  display: block;
}

.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.date-label {
  font-size: 24rpx;
  color: #666;
}

.date-value {
  font-size: 24rpx;
  color: #333;
}

.save-btn-wrapper {
  padding: 40rpx 30rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, #f5f7fa 80%, transparent);
}

.save-btn {
  width: 100%;
  background: linear-gradient(to right, #4e54c8, #8f94fb);
  color: white;
  padding: 24rpx;
  font-size: 32rpx;
  border-radius: 40rpx;
  border: none;
}
</style>
