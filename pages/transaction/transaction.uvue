  background: white;
  color: #4e54c8;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.amount-card {
  background: #fff;
  margin: 0 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

