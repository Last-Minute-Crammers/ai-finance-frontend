}

.date-value {
  font-size: 24rpx;
  color: #333;
}

.save-btn-wrapper {
  padding: 40rpx 30rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, #f5f7fa 80%, transparent);
}

.save-btn {
  width: 100%;
  background: linear-gradient(to right, #4e54c8, #8f94fb);
  color: white;
  padding: 24rpx;
  font-size: 32rpx;
  border-radius: 40rpx;
  border: none;
}
</style>
