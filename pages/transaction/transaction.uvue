  display: flex;
  align-items: center;
  font-size: 44rpx;
  margin-bottom: 20rpx;
}

.currency {
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 44rpx;
}

.section-label {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.category-item {
  background: #f4f4f4;
  border-radius: 16rpx;
  padding: 20rpx 0;
