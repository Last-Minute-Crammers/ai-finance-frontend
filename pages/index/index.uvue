<template>
  <view class="container">
    <!-- 顶部标题 -->
    <view class="header">
      <text class="title">智能记账</text>
    </view>

    <!-- 余额与花销卡片 -->
    <view class="balance-card">
      <view class="summary-block">
        <text class="balance-label">当前余额</text>
        <text class="balance-value">¥{{ balance.toFixed(2) }}</text>
      </view>
      <view class="divider" />
      <view class="summary-block">
        <text class="balance-label">本月收支</text>
        <view class="expense-row">
          <text class="expense-icon" :class="monthlyNet >= 0 ? 'positive' : 'negative'">
            {{ monthlyNet >= 0 ? '🔺' : '🔻' }}
          </text>
          <text class="balance-value" :class="monthlyNet >= 0 ? 'income' : 'expense'">
            ¥{{ Math.abs(monthlyNet).toFixed(2) }}
          </text>
        </view>
      </view>
    </view>

    <!-- 功能区 -->
    <view class="feature-grid">
      <view
        class="feature-item"
        v-for="(item, index) in features"
        :key="index"
        @click="goPage(item.path)"
      >
        <image :src="item.icon" class="feature-icon" />
        <text class="feature-title">{{ item.name }}</text>
        <text class="feature-sub">{{ item.desc }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { getTotalStatistic, getMonthStatistic } from '../../common/api/transaction'

export default {
  data() {
    return {
      balance: 0,
      monthlyNet: 0, // 改为月度净收支
      features: [
        { name: '记账', desc: '记录每一笔收支', icon: '/static/icons/book.png', path: '/pages/transaction/transaction' },
        { name: '财务分析', desc: '可视化您的消费', icon: '/static/icons/chart.png', path: '/pages/analyze/analyze' },
        { name: 'AI理财宠物', desc: '陪伴式理财体验', icon: '/static/icons/pet.png', path: '/pages/pet/pet' },
        { name: '财务报告', desc: '智能分析建议', icon: '/static/icons/report.png', path: '/pages/report/report' },
        { name: '社交互动', desc: '与好友一起理财', icon: '/static/icons/social.png', path: '/pages/social/social' },
        { name: '设置', desc: '个性化您的体验', icon: '/static/icons/settings.png', path: '/pages/settings/settings' }
      ]
    }
  },
  onShow() {
    this.loadStatisticData()
  },
  mounted() {
    this.loadStatisticData()
  },
  methods: {
    goPage(path) {
      uni.navigateTo({ url: path });
    },
    
    // 使用后端统计接口加载数据
    async loadStatisticData() {
      try {
        console.log('开始加载统计数据...');
        
        // 检查token是否存在
        const token = uni.getStorageSync('token');
        if (!token) {
          console.error('没有找到token，跳转到登录页');
          uni.navigateTo({
            url: '/pages/login/login'
          });
          return;
        }
        
        // 1. 获取总资产统计
        console.log('=== 开始获取总资产统计 ===');
        const totalRes = await getTotalStatistic();
        console.log('总统计原始响应:', JSON.stringify(totalRes, null, 2));
        
        if (totalRes && totalRes.data) {
          console.log('总统计数据解析:');
          console.log('- total_assets:', totalRes.data.total_assets);
          console.log('- income:', totalRes.data.income);
          console.log('- expense:', totalRes.data.expense);
          
          // 总资产就是收入减去支出，后端已经计算好了
          this.balance = totalRes.data.total_assets / 100; // 转换为元
          console.log('设置余额为:', this.balance);
        } else {
          console.error('总统计响应数据为空或格式错误');
        }
        
        // 2. 获取本月统计
        console.log('=== 开始获取本月统计 ===');
        const now = new Date();
        const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
        const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0);
        
        console.log('查询时间范围:', {
          start: monthStart.toISOString(),
          end: monthEnd.toISOString()
        });
        
        const monthlyRes = await getMonthStatistic({
          startTime: monthStart.toISOString(),
          endTime: monthEnd.toISOString()
          // 不指定incomeExpense，获取收入和支出
        });
        
        console.log('月度统计原始响应:', JSON.stringify(monthlyRes, null, 2));
        
        // 修正数据解析逻辑 - 匹配后端返回格式
        if (monthlyRes && monthlyRes.data) {
          if (monthlyRes.data.List && Array.isArray(monthlyRes.data.List)) {
            console.log('月度统计List长度:', monthlyRes.data.List.length);
            
            if (monthlyRes.data.List.length > 0) {
              const monthData = monthlyRes.data.List[0];
              console.log('第一个月数据:', JSON.stringify(monthData, null, 2));
              
              if (monthData) {
                const monthIncome = (monthData.income?.amount || 0) / 100; // 转换为元
                const monthExpense = (monthData.expense?.amount || 0) / 100; // 转换为元
                this.monthlyNet = monthIncome - monthExpense; // 计算净收支
                
                console.log('月度收支计算:');
                console.log('- 收入:', monthIncome);
                console.log('- 支出:', monthExpense);
                console.log('- 净收支:', this.monthlyNet);
              }
            } else {
              console.log('月度统计List为空');
            }
          } else {
            console.error('月度统计响应格式错误，缺少List字段或List不是数组');
          }
        } else {
          console.error('月度统计响应数据为空');
        }
        
        console.log('=== 最终统计结果 ===');
        console.log('余额:', this.balance); 
        console.log('月度净收支:', this.monthlyNet);
        
      } catch (error) {
        console.error('加载统计数据失败:', error);
        
        // 修复TypeScript类型错误 - 安全地检查error对象
        const errorMessage = (error && typeof error === 'object' && 'message' in error) 
          ? String(error.message) 
          : String(error);
        
        if (errorMessage.includes('Unauthorized')) {
          console.log('Token过期，清除本地存储并跳转到登录页');
          uni.removeStorageSync('token');
          uni.removeStorageSync('current_user');
          uni.showToast({
            title: '登录已过期，请重新登录',
            icon: 'none'
          });
          setTimeout(() => {
            uni.navigateTo({
              url: '/pages/login/login'
            });
          }, 1500);
        } else {
          this.balance = 0;
          this.monthlyNet = 0;
          uni.showToast({
            title: '数据加载失败',
            icon: 'none'
          });
        }
      }
    }
  }
}
</script>

<style scoped>
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f2f3f5;
}

/* 顶部标题 */
.header {
  height: 140rpx;
  background: linear-gradient(to right, #4e54c8, #8f94fb);
  display: flex;
  align-items: center;
  justify-content: center;
}
