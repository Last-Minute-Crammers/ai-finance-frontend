  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

/* 余额 + 花销卡片 */
.balance-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  width: 80%;
  margin: -30rpx auto 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.summary-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 6rpx;
}
.balance-label {
  font-size: 24rpx;
  color: #666;
}
.balance-value {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-top: 4rpx;
}
.balance-value.expense {
  color: #ff3b30;
}
.balance-value.income {
  color: #34c759; /* 绿色表示正收支 */
}
.expense-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}
.expense-icon {
  font-size: 30rpx;
  margin-right: 6rpx;
}
.expense-icon.positive {
  color: #34c759; /* 绿色向上箭头 */
}
.expense-icon.negative {
  color: #ff3b30; /* 红色向下箭头 */
}
.divider {
  width: 60%;
  height: 1rpx;
  background-color: #eee;
  margin: 14rpx 0;
}

/* 功能区：3行2列 */
.feature-grid {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: space-around;
  padding: 0 24rpx;
}
.feature-item {
  width: 48%;
  height: 30%;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
  display: flex;
  flex-direction: column;    /* 垂直布局 */
  align-items: center;       /* 横向居中 */
  justify-content: center;   /* 垂直居中整个内容块 */
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 20rpx;
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.feature-title {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  text-align: center;
}

.feature-sub {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
  text-align: center;
}
</style>
