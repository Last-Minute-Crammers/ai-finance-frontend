  color: #333;
  margin-bottom: 24rpx;
}

/* 标签组 */
.tag-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.tag {
  padding: 12rpx 24rpx;
  background: #eef1f7;
  border-radius: 30rpx;
