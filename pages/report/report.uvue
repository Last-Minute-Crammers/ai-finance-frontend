  font-size: 24rpx;
  color: #f0f0f0;
  margin-top: 10rpx;
}

.tabs {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  padding: 6rpx;
}
.tab {
  font-size: 26rpx;
  color: white;
  padding: 12rpx 36rpx;
  border-radius: 30rpx;
  text-align: center;
}
.tab.active {
  background: #fff;
  color: #4e54c8;
  font-weight: bold;
}

/* 生成按钮 */
.generate-section {
  margin: 30rpx;
}

.generate-btn {
  width: 100%;
  background: linear-gradient(to right, #4e54c8, #8f94fb);
  color: white;
  font-size: 28rpx;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-weight: bold;
}

.generate-btn:disabled {
  background: #ccc;
  color: #999;
}

/* 卡片 */
.card {
  background: #fff;
  margin: 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 报告头部 */
.report-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.report-title {
  font-size: 28rpx;
  font-weight: bold;
}
.report-date {
  font-size: 24rpx;
  color: #999;
}

/* 四格布局 */
.report-grid {
  display: flex;
  flex-wrap: wrap;
  flex-direction:row;
  justify-content: space-between;
  gap: 20rpx 0;
}
.report-item {
  width: 48%;
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
   text-align: center; 
}
.label {
  font-size: 22rpx;
  color: #999;
}
.value {
  font-size: 30rpx;
  font-weight: bold;
  margin: 10rpx 0;
}
.trend {
  font-size: 22rpx;
}
.green {
  color: #35b765;
}
.red {
  color: #e74c3c;
}
