<template>
  <view class="container">
    <!-- 顶部标题栏 -->
    <view class="header">
      <text class="back">←</text>
      <text class="title">财务报告</text>
      <text class="subtitle">智能分析您的财务状况</text>

      <view class="tabs">
        <view
          v-for="tab in tabs"
          :key="tab"
          :class="['tab', activeTab === tab ? 'active' : '']"
          @click="activeTab = tab"
        >
          {{ tab }}
        </view>
      </view>
    </view>

    <!-- 报告区块 -->
    <view class="card report-card">
      <view class="report-header">
        <text class="report-title">10月财务报告</text>
        <text class="report-date">生成于 2023-11-01</text>
      </view>

      <view class="report-grid">
        <view class="report-item" v-for="item in reportData" :key="item.label">
          <text class="label">{{ item.label }}</text>
          <text class="value">{{ item.value }}</text>
          <text :class="['trend', item.trendType]">{{ item.trend }}</text>
        </view>
      </view>
    </view>

    <!-- AI 总结与建议区块 -->
    <view class="card ai-card">
      <text class="section-title">AI收支总结</text>
      <view class="summary">{{ summary }}</view>
      <text class="section-title" style="margin-top: 24rpx;">AI理财建议</text>
      <view class="suggestion">{{ suggestion }}</view>
      <view class="tag-row">
        <view class="tag" v-for="tag in tags" :key="tag">{{ tag }}</view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, watch } from 'vue'
import { getAIReport } from '@/common/api/report'
import { getMonthStatistic, getMonthlyStatistic } from '@/common/api/transaction'
// 新增：获取类别统计数据和单日/单周统计数据的API（假设已实现）
import { getCategoryStatistic, getDailyStatistic, getWeeklyStatistic } from '@/common/api/transaction'

const tabs = ['周报', '月报', '年报']
const activeTab = ref('月报')

const summary = ref('')
const suggestion = ref('')
const tags = ref<string[]>([])

// 统计数据对象
const yourStatsData = ref({})

// 获取近一周、近一月、近一年时间范围
function getTimeRange(type: 'week' | 'month' | 'year') {
  const now = new Date()
  let start: Date
  if (type === 'week') {
    start = new Date(now)
    start.setDate(now.getDate() - 6)
  } else if (type === 'month') {
    start = new Date(now)
    start.setMonth(now.getMonth() - 1)
  } else {
    start = new Date(now)
    start.setFullYear(now.getFullYear() - 1)
  }
  // 统一为 ISO 字符串
  return {
    startTime: start.toISOString(),
    endTime: now.toISOString()
  }
}

// 获取统计数据
async function fetchStats(type: 'week' | 'month' | 'year') {
  const { startTime, endTime } = getTimeRange(type)
  // 转为 Date 对象，后端才能正确解析
  const start = new Date(startTime)
  const end = new Date(endTime)
  let res
  if (type === 'week') {
    res = await getMonthStatistic({ startTime: start, endTime: end })
  } else if (type === 'month') {
    res = await getMonthStatistic({ startTime: start, endTime: end })
  } else {
    res = await getMonthlyStatistic({ startTime: start, endTime: end })
  }
  yourStatsData.value = res.data
  return res.data // 新增返回数据
}

async function fetchAIReport() {
  const type = activeTab.value === '周报' ? 'week' : activeTab.value === '月报' ? 'month' : 'year'
  // 1. 获取主统计数据
  const statsArr = await fetchStats(type)
  let promptStats: any = {}
  let categoryStats: any = {}
  let extraStats: any = {}

  // 统一时间范围
  const now = new Date();
  let start: Date, end: Date;
  if (type === 'week') {
    start = new Date(now);
    start.setDate(now.getDate() - 6);
    end = now;
  } else if (type === 'month') {
    start = new Date(now.getFullYear(), now.getMonth(), 1);
    end = new Date(now.getFullYear(), now.getMonth() + 1, 0);
  } else {
    start = new Date(now.getFullYear(), now.getMonth() - 11, 1);
    end = now;
  }
  const startTime = start.toISOString();
  const endTime = end.toISOString();

  if (type === 'week') {
    let weekList = Array.isArray(statsArr?.List) ? statsArr.List : []
    weekList = weekList.filter(item =>
      Number(item.income?.amount || item.Income?.Amount || 0) !== 0 ||
      Number(item.expense?.amount || item.Expense?.Amount || 0) !== 0
    )
    if (weekList.length === 0 && Array.isArray(statsArr?.List)) {
      weekList = statsArr.List
    }
    promptStats = { list: weekList }
    const categoryRes = await getCategoryStatistic({
      startTime,
      endTime,
      incomeExpense: 'expense',
      limit: 10
    })
    categoryStats = categoryRes?.data?.List || []
    const dailyRes = await getDailyStatistic({
      startTime,
      endTime,
      incomeExpense: 'expense'
    })
    extraStats = dailyRes?.data?.List || []
  } else if (type === 'month') {
    let monthList = Array.isArray(statsArr?.List) ? statsArr.List : []
    monthList = monthList.filter(item =>
      Number(item.income?.amount || item.Income?.Amount || 0) !== 0 ||
      Number(item.expense?.amount || item.Expense?.Amount || 0) !== 0
    )
    if (monthList.length === 0 && Array.isArray(statsArr?.List)) {
      monthList = statsArr.List
    }
    promptStats = { list: monthList }
    const categoryRes = await getCategoryStatistic({
      startTime,
      endTime,
      incomeExpense: 'expense',
      limit: 10
    })
    categoryStats = categoryRes?.data?.List || []
    const weeklyRes = await getWeeklyStatistic({
      startTime,
      endTime,
      incomeExpense: 'expense'
    })
    extraStats = weeklyRes?.data?.List || []
  } else {
    let yearList = Array.isArray(statsArr?.List) ? statsArr.List : []
    yearList = yearList.filter(item =>
      Number(item.income?.amount || item.Income?.Amount || 0) !== 0 ||
      Number(item.expense?.amount || item.Expense?.Amount || 0) !== 0
    )
    if (yearList.length === 0 && Array.isArray(statsArr?.List)) {
      yearList = statsArr.List
    }
    promptStats = { list: yearList }
    const categoryRes = await getCategoryStatistic({
      startTime,
      endTime,
      incomeExpense: 'expense',
      limit: 10
    })
    categoryStats = categoryRes?.data?.List || []
    // 年报不需要额外的extraStats
  }

  // 组装prompt参数
  const aiPrompt = {
    type,
    stats: promptStats,
    categoryStats,
    extraStats
  }

  const res = await getAIReport(aiPrompt)
  summary.value = res.summary
  suggestion.value = res.suggestion
  tags.value = res.tags
}

watch(activeTab, fetchAIReport, { immediate: true })

const reportData = [
  { label: '总收入', value: '¥8,500', trend: '↑5% 较上月', trendType: 'green' },
  { label: '总支出', value: '¥4,200', trend: '↓12% 较上月', trendType: 'red' },
  { label: '储蓄率', value: '50.6%', trend: '↑3% 较上月', trendType: 'green' },
  { label: '预算执行', value: '82%', trend: '↓8% 较上月', trendType: 'red' }
]
</script>

