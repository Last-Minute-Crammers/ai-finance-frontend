<template>
  <view class="container">
    <!-- 顶部标题栏 -->
    <view class="header">
      <text class="back">←</text>
      <text class="title">财务报告</text>
      <text class="subtitle">智能分析您的财务状况</text>

      <view class="tabs">
        <view
          v-for="tab in tabs"
          :key="tab"
          :class="['tab', activeTab === tab ? 'active' : '']"
          @click="activeTab = tab"
        >
          {{ tab }}
        </view>
      </view>
    </view>

    <!-- 报告区块 -->
    <view class="card report-card">
      <view class="report-header">
        <text class="report-title">10月财务报告</text>
        <text class="report-date">生成于 2023-11-01</text>
      </view>

      <view class="report-grid">
        <view class="report-item" v-for="item in reportData" :key="item.label">
          <text class="label">{{ item.label }}</text>
          <text class="value">{{ item.value }}</text>
          <text :class="['trend', item.trendType]">{{ item.trend }}</text>
        </view>
      </view>
    </view>

    <!-- AI 总结与建议区块 -->
    <view class="card ai-card">
      <text class="section-title">AI收支总结</text>
      <view class="summary">{{ summary }}</view>
      <text class="section-title" style="margin-top: 24rpx;">AI理财建议</text>
      <view class="suggestion">{{ suggestion }}</view>
      <view class="tag-row">
        <view class="tag" v-for="tag in tags" :key="tag">{{ tag }}</view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, watch, onMounted } from 'vue'
import { getHistoryReport } from '../../common/api/report'

const tabs = ['周报', '月报', '年报']
const activeTab = ref('月报')

const summary = ref('')
const suggestion = ref('')
const tags = ref<string[]>([])

function getPeriod(type: 'week' | 'month' | 'year') {
  const now = new Date()
  if (type === 'week') {
    const year = now.getFullYear()
    // 使用与后端一致的周数计算方式
    const week = Math.ceil((now.getTime() - new Date(year, 0, 1).getTime()) / (7 * 24 * 60 * 60 * 1000) + 1)
    return `${year}-W${String(week).padStart(2, '0')}`
  } else if (type === 'month') {
    return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`
  } else {
    return `${now.getFullYear()}`
  }
}

async function fetchHistoryReport() {
  const type = activeTab.value === '周报' ? 'week' : activeTab.value === '月报' ? 'month' : 'year'
  const period = getPeriod(type)
  console.log('请求历史报告参数:', { type, period })
  try {
    const res = await getHistoryReport(type, period)
    console.log('历史报告响应:', res)
    if (res?.data?.data) {
      summary.value = res.data.data.Summary
      suggestion.value = res.data.data.Suggestion
      tags.value = JSON.parse(res.data.data.Tags || '[]')
      return
    } else {
      // 没有历史报告数据，显示默认信息
      summary.value = '还没有开始记账，暂无历史报告。'
      suggestion.value = ''
      tags.value = []
    }
  } catch (e) {
    console.error('获取历史报告失败:', e)
    summary.value = '还没有开始记账，暂无历史报告。'
    suggestion.value = ''
    tags.value = []
  }
}

onMounted(fetchHistoryReport)
watch(activeTab, fetchHistoryReport, { immediate: true })

const reportData = [
  { label: '总收入', value: '¥8,500', trend: '↑5% 较上月', trendType: 'green' },
  { label: '总支出', value: '¥4,200', trend: '↓12% 较上月', trendType: 'red' },
  { label: '储蓄率', value: '50.6%', trend: '↑3% 较上月', trendType: 'green' },
  { label: '预算执行', value: '82%', trend: '↓8% 较上月', trendType: 'red' }
]
</script>

