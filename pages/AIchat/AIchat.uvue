<template>
  <view class="chat-wrapper">
    <!-- 顶部栏 -->
    <view class="chat-header">
      <text class="chat-title">AI 理财助手</text>
      <text class="chat-subtitle">您的智能理财小伙伴</text>
    </view>

    <!-- 聊天气泡区域 -->
    <scroll-view class="chat-body" scroll-y :scroll-into-view="scrollIntoView" scroll-with-animation>
      <view v-for="(msg, index) in messages" :key="index" :id="'msg-' + index"
        class="chat-message" :class="msg.role">
        <image class="avatar" :src="msg.role === 'ai' ? aiAvatar : userAvatar" />
        <view class="bubble">
          <text>{{ msg.text }}</text>
          <view v-if="msg.loading" class="loading-dots">
            <text class="dot">·</text>
            <text class="dot">·</text>
            <text class="dot">·</text>
          </view>
        </view>
      </view>
      <view :id="bottomAnchor" class="scroll-anchor"></view>
    </scroll-view>

    <!-- 输入栏 -->
    <view class="input-area">
      <input class="input-box" v-model="inputText" placeholder="请输入内容..." @confirm="sendMessage" :disabled="isLoading" />
      <button class="send-button" @tap="sendMessage" :disabled="isLoading || !inputText.trim()">
        {{ isLoading ? '发送中...' : '发送' }}
      </button>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, nextTick } from 'vue'
import { sendAIMessage } from '../../common/api/finance'

interface ChatMessage {
  role: 'ai' | 'user';
  text: string;
  loading?: boolean;
}

const aiAvatar = '/static/icons/pet.png'
const userAvatar = '/static/icons/user.png'

const inputText = ref('')
const isLoading = ref(false)
const messages = ref<ChatMessage[]>([
  { role: 'ai', text: '你好，我是理财小汪，你的智能理财助手，有什么可以帮您？' }
])
const bottomAnchor = 'bottom-anchor'
const scrollIntoView = ref(bottomAnchor)

async function sendMessage() {
  const content = inputText.value.trim();
  if (!content || isLoading.value) return;

  // 添加用户消息
  messages.value.push({ role: 'user', text: content });
  inputText.value = '';
  scrollToBottom();

  // 添加AI加载消息
  const loadingMsgIndex = messages.value.length;
  messages.value.push({ role: 'ai', text: '正在思考中...', loading: true });
  scrollToBottom();

  isLoading.value = true;

  try {
    // 确保发送的参数符合后端预期，并解构返回值
    const response = await sendAIMessage({ message: content });
    // 移除加载消息，添加AI回复
    messages.value.splice(loadingMsgIndex, 1);
    
    // 检查响应结构并处理成功/失败情况
    if (response.success && response.data) {
      messages.value.push({ role: 'ai', text: response.data });
    } else {
      // 处理后端返回的错误信息
      const errorMsg = response.error || '抱歉，我暂时无法回答这个问题。';
      messages.value.push({ role: 'ai', text: errorMsg });
    }
  } catch (error) {
    // 移除加载消息，添加错误提示
    messages.value.splice(loadingMsgIndex, 1);
    messages.value.push({
      role: 'ai',
      text: '抱歉，我暂时无法连接到AI服务。请稍后再试或联系技术支持。',
    });
    console.error('AI chat error:', error);

    uni.showToast({
      title: 'AI服务暂时不可用',
      icon: 'none',
    });
  } finally {
    isLoading.value = false;
    scrollToBottom();
  }
}

function scrollToBottom() {
  nextTick(() => {
    scrollIntoView.value = bottomAnchor
  })
}
</script>

<style scoped>
.chat-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f7fa;
}

.chat-header {
  background: linear-gradient(to right,#4e54c8, #8f94fb);
  color: white;
  padding: 40rpx 32rpx 24rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  text-align: center;
}
.chat-title {
  font-size: 36rpx;
  font-weight: bold;
}
.chat-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}

.chat-body {
  flex: 1;
  padding: 30rpx 24rpx;
}

.chat-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}
.chat-message.ai {
  flex-direction: row;
}
.chat-message.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 16rpx;
}

.bubble {
  max-width: 70%;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  color: #333;
  word-wrap: break-word;
}
.chat-message.user .bubble {
  background-color: #dcefff;
}

.input-area {
  padding: 20rpx;
  display: flex;
  border-top: 1rpx solid #eee;
  background-color: #fff;
}
.input-box {
  flex: 1;
  border: 1px solid #ccc;
  border-radius: 30rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
}
.send-button {
  margin-left: 20rpx;
  height: 70rpx;
  padding: 0 32rpx;
  line-height: 70rpx;
  background-color: #4e54c8;
  color: #fff;
  font-size: 28rpx;
  border-radius: 32rpx;
}
.scroll-anchor {
  height: 1rpx;
}

.loading-dots {
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

.dot {
  font-size: 40rpx;
  color: #999;
  animation: blink 1.4s infinite both;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%, 80%, 100% {
    opacity: 0;
  }
  40% {
    opacity: 1;
  }
}

.send-button:disabled {
  background-color: #ccc;
  color: #999;
}

.input-box:disabled {
  background-color: #f0f0f0;
  color: #999;
}
</style>
