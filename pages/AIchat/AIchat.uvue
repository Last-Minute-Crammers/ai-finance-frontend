  font-size: 36rpx;
  font-weight: bold;
}
.chat-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}

.chat-body {
  flex: 1;
  padding: 30rpx 24rpx;
}

.chat-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}
.chat-message.ai {
  flex-direction: row;
}
.chat-message.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 16rpx;
}

.bubble {
  max-width: 70%;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  color: #333;
  word-wrap: break-word;
}
.chat-message.user .bubble {
  background-color: #dcefff;
}

.input-area {
  padding: 20rpx;
  display: flex;
  border-top: 1rpx solid #eee;
  background-color: #fff;
}
.input-box {
  flex: 1;
  border: 1px solid #ccc;
  border-radius: 30rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
}
.send-button {
  margin-left: 20rpx;
  height: 70rpx;
  padding: 0 32rpx;
  line-height: 70rpx;
  background-color: #4e54c8;
  color: #fff;
  font-size: 28rpx;
  border-radius: 32rpx;
}
.scroll-anchor {
  height: 1rpx;
}

.history-btn {
  position: absolute;
  right: 32rpx;
  top: 40rpx;
  background: #fff;
  color: #4e54c8;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border: 1rpx solid #4e54c8;
}
.drawer-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.2);
  z-index: 99;
}
.drawer {
  position: fixed;
  top: 0; right: 0; bottom: 0;
  width: 70vw;
  max-width: 500rpx;
  background: #fff;
  z-index: 100;
  box-shadow: -4rpx 0 16rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
}
.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 30rpx;
  font-weight: bold;
}
.drawer-close {
  background: #f5f7fa;
  color: #888;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
  border: none;
}
.drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}
.drawer-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
}
.drawer-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.drawer-date {
  font-size: 22rpx;
  color: #aaa;
  margin-left: 12rpx;
}
.drawer-loading, .drawer-empty {
  color: #888;
  text-align: center;
  margin-top: 40rpx;
  font-size: 26rpx;
}
</style>
