  background-color: #ccc;
}

.status {
  font-weight: bold;
  padding: 5px 10px;
  border-radius: 4px;
}

.成功 {
  color: #4CAF50;
  background-color: #E8F5E8;
}

.失败 {
  color: #F44336;
  background-color: #FFEBEE;
}

.需要登录 {
  color: #FF9800;
  background-color: #FFF3E0;
}

.在线 {
  color: #4CAF50;
  background-color: #E8F5E8;
}

.离线 {
  color: #F44336;
  background-color: #FFEBEE;
}

.错误 {
  color: #FF9800;
  background-color: #FFF3E0;
}

.results {
  margin-bottom: 30px;
}

.results-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;
}

.result-item {
  padding: 8px;
  background-color: white;
  margin-bottom: 5px;
  border-radius: 4px;
}

.result-text {
  font-size: 14px;
  color: #666;
}

.diagnostic-section {
  background-color: white;
  padding: 15px;
  border-radius: 8px;
  margin-bottom: 20px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;
}

.diagnostic-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  padding: 5px 0;
  border-bottom: 1px solid #f0f0f0;
}

.diagnostic-label {
  font-weight: bold;
  color: #555;
}

.diagnostic-value {
  color: #333;
}

.health-details {
  background-color: white;
  padding: 15px;
  border-radius: 8px;
}

.details-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

.service-name {
  font-weight: bold;
  color: #555;
}

.healthy {
  color: #4CAF50;
}

.unhealthy {
  color: #F44336;
}

.advanced-section {
  background-color: #f0f0f0;
  padding: 15px;
  margin: 15px 0;
  border-radius: 8px;
}

.input-group {
  display: flex;
  margin-bottom: 10px;
}

.input-field {
  flex: 1;
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 4px;
  margin-right: 10px;
}

.small-button {
  padding: 0 15px;
  background-color: #007AFF;
  color: white;
  height: auto;
  line-height: 32px;
  font-size: 14px;
}

.advanced-button {
  width: 100%;
  background-color: #7047EB;
}

.diagnostic-detail {
  background-color: #FFF9E6;
  padding: 15px;
  margin: 15px 0;
  border-radius: 8px;
  border-left: 4px solid #FFC107;
}

.detail-title {
  font-weight: bold;
  font-size: 16px;
  color: #B78105;
  margin-bottom: 10px;
}

.detail-item {
  display: flex;
  margin-bottom: 8px;
}

.detail-label {
  font-weight: bold;
  width: 80px;
  color: #666;
}

.cause-item {
  display: flex;
  padding: 5px 0 5px 15px;
}

.cause-number {
  margin-right: 5px;
  color: #B78105;
  font-weight: bold;
}

.cause-text {
  color: #333;
  flex: 1;
}

.advanced-toggle {
  margin: 20px 0;
  text-align: center;
}

.toggle-button {
  background-color: #f0f0f0;
