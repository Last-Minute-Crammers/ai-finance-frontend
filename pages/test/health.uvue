<template>
  <view class="health-test-page">
    <view class="header">
      <text class="title">后端连接健康检查</text>
      <text class="backend-url">后端地址: {{ backendUrl }}</text>
    </view>
    
    <view class="test-section">
      <view class="test-item">
        <button @click="checkBackendStatus" :disabled="loading">
          检查后端服务状态
        </button>
        <text class="status" :class="connectionStatus.backend">
          {{ connectionStatus.backend }}
        </text>
      </view>
      
      <view class="test-item">
        <button @click="testBasicConnection" :disabled="loading">
          测试基础连接
        </button>
        <text class="status" :class="connectionStatus.basic">
          {{ connectionStatus.basic }}
        </text>
      </view>
      
      <view class="test-item">
        <button @click="testHealthEndpoint" :disabled="loading">
          测试健康检查端点
        </button>
        <text class="status" :class="connectionStatus.health">
          {{ connectionStatus.health }}
        </text>
      </view>
      
      <view class="test-item">
        <button @click="testPublicAPI" :disabled="loading">
          测试公开API
        </button>
        <text class="status" :class="connectionStatus.public">
          {{ connectionStatus.public }}
        </text>
      </view>
      
      <view class="test-item">
        <button @click="testPrivateAPI" :disabled="loading">
          测试私有API (需要登录)
        </button>
        <text class="status" :class="connectionStatus.private">
          {{ connectionStatus.private }}
        </text>
      </view>
      
      <view class="test-item">
        <button @click="testAIChat" :disabled="loading">
          测试AI对话功能
        </button>
        <text class="status" :class="connectionStatus.aiChat">
          {{ connectionStatus.aiChat }}
        </text>
      </view>
      
      <view class="test-item">
        <button @click="runAllTests" :disabled="loading">
          运行所有测试
        </button>
      </view>
    </view>
    
    <view class="diagnostic-section">
      <text class="section-title">连接诊断信息</text>
      <view class="diagnostic-item">
        <text class="diagnostic-label">后端地址:</text>
        <text class="diagnostic-value">{{ backendUrl }}</text>
      </view>
      <view class="diagnostic-item">
        <text class="diagnostic-label">网络状态:</text>
        <text class="diagnostic-value">{{ networkStatus }}</text>
      </view>
      <view class="diagnostic-item">
        <text class="diagnostic-label">最后测试时间:</text>
        <text class="diagnostic-value">{{ lastTestTime }}</text>
      </view>
    </view>
    
    <view class="results">
      <text class="results-title">测试结果:</text>
      <view class="result-item" v-for="(result, index) in testResults" :key="index">
        <text class="result-text">{{ result }}</text>
      </view>
    </view>
    
    <view v-if="healthData" class="health-details">
      <text class="details-title">服务状态详情:</text>
      <view class="detail-item" v-for="(status, service) in healthData.services" :key="service">
        <text class="service-name">{{ service }}:</text>
        <text class="service-status" :class="status.includes('healthy') ? 'healthy' : 'unhealthy'">
          {{ status }}
        </text>
      </view>
    </view>

    <view v-if="showAdvancedOptions" class="advanced-section">
      <text class="section-title">高级选项</text>
      <view class="input-group">
        <input v-model="customServerUrl" class="input-field" placeholder="服务器地址 (例如: http://192.168.1.100:8080)" />
        <button @click="setCustomServerUrl" class="small-button">设置</button>
      </view>
      <button @click="diagnoseConnection" :disabled="loading" class="advanced-button">
        运行网络诊断
      </button>
    </view>
    
    <view class="advanced-toggle">
      <button @click="showAdvancedOptions = !showAdvancedOptions" class="toggle-button">
        {{ showAdvancedOptions ? '隐藏高级选项' : '显示高级选项' }}
      </button>
    </view>
    
    <view v-if="diagnostics" class="diagnostic-detail">
      <text class="detail-title">连接诊断详情</text>
      <view class="detail-item">
        <text class="detail-label">服务器:</text>
        <text class="detail-value">{{ diagnostics.serverUrl }}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">错误类型:</text>
        <text class="detail-value">{{ diagnostics.errorType }}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">可能原因:</text>
      </view>
      <view class="cause-item" v-for="(cause, idx) in diagnostics.possibleCauses" :key="idx">
        <text class="cause-number">{{ idx + 1 }}.</text>
        <text class="cause-text">{{ cause }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { testConnection, healthCheck, request, checkBackendConnection, setBackendUrl } from '../../utils/request'
import { getTransactionList, getCategoryList, sendAIMessage } from '../../common/api/finance'

export default {
  data() {
    return {
      loading: false,
      connectionStatus: {
        backend: '未测试',
        basic: '未测试',
        health: '未测试',
        public: '未测试',
        private: '未测试',
        aiChat: '未测试'
      },
      testResults: [],
      healthData: null,
      backendUrl: 'http://localhost:8080',
      networkStatus: '检测中...',
      lastTestTime: '未测试',
      diagnostics: null,
      customServerUrl: '',
      showAdvancedOptions: false
    }
  },
  methods: {
    setCustomServerUrl() {
      if (!this.customServerUrl) {
        uni.showToast({
          title: '请输入有效的服务器地址',
          icon: 'none'
        })
        return
      }
      
      setBackendUrl(this.customServerUrl)
      this.backendUrl = this.customServerUrl
      this.addResult(`✅ 已设置后端地址为: ${this.customServerUrl}`)
      
      this.checkBackendStatus()
    },
    
    async checkBackendStatus() {
      this.loading = true
      this.diagnostics = null
      try {
        const result = await checkBackendConnection()
        if (result.connected) {
          this.connectionStatus.backend = '在线'
          this.addResult(`✅ 后端服务在线 (响应时间: ${result.responseTime}ms)`)
        } else {
          this.connectionStatus.backend = '离线'
          this.addResult('❌ 后端服务离线或无响应')
          
          if (result.diagnostics) {
            this.diagnostics = result.diagnostics
            this.addResult(`📊 可能的原因: ${result.diagnostics.possibleCauses.join(', ')}`)
          }
        }
      } catch (error) {
        this.connectionStatus.backend = '错误'
        this.addResult('❌ 后端状态检查失败: ' + error.message)
      }
      this.lastTestTime = new Date().toLocaleString()
      this.loading = false
    },

    async testBasicConnection() {
      this.loading = true
      try {
        await testConnection(2)
        this.connectionStatus.basic = '成功'
        this.addResult('✅ 基础连接测试成功')
      } catch (error) {
        this.connectionStatus.basic = '失败'
        this.addResult('❌ 基础连接测试失败: ' + error.message)
        
        if (error.message.includes('404')) {
          this.addResult('💡 建议: 检查后端路由 /api/test 是否已配置')
        } else if (error.message.includes('timeout')) {
          this.addResult('💡 建议: 检查后端服务是否正在运行在端口8080')
        } else if (error.message.includes('连接失败')) {
          this.addResult('💡 建议: 确认后端服务已启动且端口8080可访问')
          this.addResult('💡 可能原因: 防火墙阻止访问、后端服务未启动、端口被占用')
        }
      }
      this.loading = false
    },
    
    async testHealthEndpoint() {
      this.loading = true
      try {
        const response = await healthCheck()
        this.connectionStatus.health = '成功'
        this.healthData = response
        this.addResult('✅ 健康检查端点测试成功')
      } catch (error) {
        this.connectionStatus.health = '失败'
        this.addResult('❌ 健康检查端点测试失败: ' + error.message)
      }
      this.loading = false
    },
    
    async testPublicAPI() {
      this.loading = true
      try {
        const response = await request({
          url: '/api/public/ping',
          method: 'GET'
        })
        this.connectionStatus.public = '成功'
        this.addResult('✅ 公开API测试成功')
      } catch (error) {
        this.connectionStatus.public = '失败'
        this.addResult('❌ 公开API测试失败: ' + error.message)
      }
      this.loading = false
    },
    
    async testPrivateAPI() {
      this.loading = true
      try {
        const response = await getTransactionList()
        this.connectionStatus.private = '成功'
        this.addResult('✅ 私有API测试成功')
      } catch (error) {
        if (error.message === 'Unauthorized') {
          this.connectionStatus.private = '需要登录'
          this.addResult('⚠️ 私有API测试 - 需要登录令牌')
        } else {
          this.connectionStatus.private = '失败'
          this.addResult('❌ 私有API测试失败: ' + error.message)
        }
      }
      this.loading = false
    },
    
    async testAIChat() {
      this.loading = true
      try {
        const testMessage = '你好，请介绍一下你自己'
        const response = await sendAIMessage(testMessage)
        
        if (response.response && response.response.includes('理财小汪')) {
          this.connectionStatus.aiChat = '成功'
          this.addResult('✅ AI对话功能测试成功 - 理财小汪正常响应')
        } else {
          this.connectionStatus.aiChat = '部分成功'
          this.addResult('⚠️ AI对话功能测试 - 有响应但格式可能异常')
        }
      } catch (error) {
        this.connectionStatus.aiChat = '失败'
        this.addResult('❌ AI对话功能测试失败: ' + error.message)
      }
      this.loading = false
    },
    
    async runAllTests() {
      this.testResults = []
      this.addResult('开始运行所有测试...')
      
      await this.checkBackendStatus()
      await this.testBasicConnection()
      await this.testHealthEndpoint()
      await this.testPublicAPI()
      await this.testPrivateAPI()
      await this.testAIChat()
      
      this.addResult('所有测试完成')
    },
    
    addResult(message) {
      const timestamp = new Date().toLocaleTimeString()
      this.testResults.push(`[${timestamp}] ${message}`)
    },

    checkNetworkStatus() {
      uni.getNetworkType({
        success: (res) => {
          this.networkStatus = res.networkType || '未知'
        },
        fail: () => {
          this.networkStatus = '检测失败'
        }
      })
    },

    async diagnoseConnection() {
      this.loading = true
      this.addResult('🔍 开始网络诊断...')
      
      this.checkNetworkStatus()
      this.addResult(`📱 设备网络状态: ${this.networkStatus}`)
      
      this.addResult('🔍 测试后端服务器连通性...')
      try {
        const pingResult = await this.pingServer()
        if (pingResult.success) {
          this.addResult(`✅ 服务器可达 (响应时间: ${pingResult.time}ms)`)
        } else {
          this.addResult('❌ 服务器无响应')
        }
      } catch (error) {
        this.addResult('❌ 连接测试失败: ' + error.message)
      }
      
      this.loading = false
    },
    
    async pingServer() {
      try {
        const startTime = Date.now()
        await uni.request({
          url: this.backendUrl + '/test',
          method: 'GET',
          timeout: 2000
        })
        const endTime = Date.now()
        return {success: true, time: endTime - startTime}
      } catch (error) {
        console.error('Ping error:', error)
        return {success: false, error: error.errMsg || '未知错误'}
      }
    }
  },
  
  onLoad() {
    this.addResult('页面加载完成，准备进行健康检查')
    this.checkNetworkStatus()
    setTimeout(() => {
      this.checkBackendStatus()
    }, 1000)
  }
}
</script>

<style>
