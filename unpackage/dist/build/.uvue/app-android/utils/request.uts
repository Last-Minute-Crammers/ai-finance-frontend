// Removed unused import as '@dcloudio/types' is not a module
// 为不同环境提供后端URL选项
const BACKEND_URLS: Record<string, string> = {
    production: 'http://47.109.194.39/api',
    local: 'http://localhost:8080',
    dockerHost: 'http://host.docker.internal:8080',
    ip: 'http://127.0.0.1:8080',
    external: 'http://192.168.1.100:8080'
};
// 更新默认URL配置，使用生产环境API
const DEFAULT_URL: string = BACKEND_URLS.production; // 使用生产环境API
const getBackendUrl = (): string => {
    // Try to get from storage first (allows runtime configuration)
    const configuredUrl: string | null = uni.getStorageSync('backend_url');
    return configuredUrl || DEFAULT_URL;
};
// Get the active backend URL - this allows changing it at runtime
const BASE_URL: string = getBackendUrl();
interface RequestOptions {
    url: string;
    method?: 'GET' | 'POST' | 'PUT' | 'DELETE';
    data?: any;
    params?: any;
    requireAuth?: boolean;
    timeout?: number;
    retries?: number;
    headers?: Record<string, string>;
}
// 自定义错误接口
interface UniRequestError {
    errMsg?: string;
    message?: string;
}
// 获取存储的 token - 添加调试日志
const getToken = (): string => {
    const token: string = uni.getStorageSync('token') || '';
    console.log('Retrieved token:', token ? `${token.substring(0, 20)}...` : 'No token found');
    return token;
};
// Ensure uni is globally available or imported from the appropriate library
declare const uni: any;
// 设置后端URL
export const setBackendUrl = (url: string): void => {
    uni.setStorageSync('backend_url', url);
    console.log('Backend URL set to:', url);
};
// 增强版设置后端URL函数，支持预设环境选择
export const setBackendEnvironment = (envKey: string): string | null => {
    if (BACKEND_URLS[envKey]) {
        const url: string = BACKEND_URLS[envKey];
        setBackendUrl(url);
        return url;
    }
    return null;
};
// 增加一个获取所有可能后端URL的函数
export const getAvailableBackendUrls = (): Record<string, string> => {
    return BACKEND_URLS;
};
// 健康检查函数
export const healthCheck = async (): Promise<any> => {
    try {
        const response: any = await request({
            url: '/api/public/health',
            method: 'GET',
            timeout: 3000 // shorter timeout for health check
        });
        console.log('Backend health check:', response);
        return response;
    }
    catch (error: any) {
        const errMsg: string = (typeof error === 'object' && error != null && resolveInOperator(error, 'message'))
            ? (error as any).message
            : String(error);
        console.error('Backend connection failed:', errMsg);
        throw error;
    }
};
// 检查后端连接状态 - 优化版，支持连接诊断
export const checkBackendConnection = async (customUrl?: string): Promise<any> => {
    const targetUrl: string = customUrl || BASE_URL;
    try {
        console.log('检查后端连接状态...', targetUrl);
        const startTime: number = Date.now();
        // 修复Promise.race逻辑，确保适当处理undefined
        const requestPromise: Promise<any> = new Promise((resolve, reject) => {
            uni.request({
                url: targetUrl + '/api/test',
                method: 'GET',
                timeout: 10000,
                success: (response: any) => {
                    if (!response) {
                        reject(new Error('未收到后端响应'));
                        return;
                    }
                    resolve(response);
                },
                fail: (error: any) => {
                    reject(error || new Error('请求失败'));
                }
            });
        });
        const timeoutPromise: Promise<any> = new Promise((_, reject) => {
            setTimeout(() => reject(new Error('请求超时(10秒)')), 10000);
        });
        // 使用Promise.race正确处理响应
        const response: any = await Promise.race([requestPromise, timeoutPromise]);
        const endTime: number = Date.now();
        // 安全检查response和statusCode
        if (!response || response.statusCode === undefined) {
            throw new Error('无效的响应格式');
        }
        console.log('后端连接检查结果:', response, `响应时间: ${endTime - startTime}ms`);
        return {
            connected: response.statusCode === 200,
            statusCode: response.statusCode,
            responseTime: endTime - startTime,
            serverInfo: response.data || {}
        };
    }
    catch (error: any) {
        console.error('后端连接检查失败:', error);
        // 处理错误对象，确保类型安全
        const errMsg: string = typeof error === 'object' && error != null && resolveInOperator(error, 'message')
            ? String((error as any).message || (error as any).errMsg)
            : '未知错误';
        const isConnectionRefused: boolean = typeof errMsg === 'string' && errMsg.indexOf('CONNECTION_REFUSED') !== -1;
        const isTimeout: boolean = typeof errMsg === 'string' && (errMsg.indexOf('timeout') !== -1 || errMsg.indexOf('超时') !== -1);
        // 增强的诊断信息
        const diagnostics: {
            serverUrl: string;
            errorType: string;
            isConnectionRefused: boolean;
            isTimeout: boolean;
            possibleCauses: string[];
        } = {
            serverUrl: targetUrl,
            errorType: errMsg,
            isConnectionRefused: isConnectionRefused,
            isTimeout: isTimeout,
            possibleCauses: []
        };
        if (isConnectionRefused) {
            diagnostics.possibleCauses = [
                '后端服务器未启动',
                '端口8080可能被其他应用占用',
                '检查防火墙设置是否允许连接'
            ];
        }
        else if (isTimeout) {
            diagnostics.possibleCauses = [
                'Docker容器端口映射不正确 - 检查docker-compose.yml',
                'Docker网络配置问题 - 尝试使用127.0.0.1而不是localhost',
                '防火墙阻止了连接 - 检查防火墙设置',
                '后端服务响应过慢 - 检查服务器负载',
                '后端服务未正确监听端口 - 检查后端日志'
            ];
        }
        else {
            // 添加通用错误原因
            diagnostics.possibleCauses = [
                '后端服务未正确启动',
                'API端点路径可能不正确',
                '请求处理过程中出现错误',
                '网络连接问题'
            ];
        }
        console.log('连接诊断:', diagnostics);
        return { connected: false, error: errMsg, diagnostics };
    }
};
// 测试连接函数 - 带有重试功能
export const testConnection = async (maxRetries: number = 1): Promise<any> => {
    let retries: number = 0;
    let lastError: any;
    while (retries <= maxRetries) {
        try {
            console.log(`测试连接到 ${BASE_URL}/api/test (尝试 ${retries + 1}/${maxRetries + 1})`);
            const response: any = await request({
                url: '/api/test',
                method: 'GET',
                timeout: 3000
            });
            console.log('连接测试成功:', response);
            return {
                success: true,
                response: response,
                retries: retries
            };
        }
        catch (error: any) {
            lastError = error;
            retries++;
            if (retries <= maxRetries) {
                console.log(`连接失败，${retries}秒后重试...`);
                await new Promise((resolve, _reject) => setTimeout(resolve, 1000));
            }
        }
    }
    console.error('所有重试都失败了:', lastError);
    return {
        success: false,
        error: lastError,
        retries: retries
    };
};
// 主请求函数
export const request = async <T = any>(options: RequestOptions): Promise<T> => {
    const { url, method = 'GET', data, params, requireAuth = true, timeout = 10000, headers = {} } = options;
    // 构建完整URL
    let fullUrl: string = BASE_URL + url;
    // 处理查询参数
    if (params) {
        const queryString: string = Object.keys(params)
            .map((key): string => `${encodeURIComponent(key)}=${encodeURIComponent(params[key])}`)
            .join('&');
        fullUrl += (fullUrl.includes('?') ? '&' : '?') + queryString;
    }
    // 构建请求头
    const requestHeaders: Record<string, string> = {
        'Content-Type': 'application/json',
        ...headers
    };
    // 添加认证头
    if (requireAuth) {
        const token: string = getToken();
        if (token) {
            requestHeaders['Authorization'] = `Bearer ${token}`;
        }
    }
    return new Promise<T>((resolve, reject) => {
        uni.request({
            url: fullUrl,
            method: method,
            data: data,
            header: requestHeaders,
            timeout: timeout,
            success: (response: any) => {
                console.log(`请求成功 [${method}] ${fullUrl}:`, response);
                // 检查HTTP状态码
                if (response.statusCode >= 200 && response.statusCode < 300) {
                    resolve(response.data);
                }
                else {
                    const error: UniRequestError = {
                        message: `HTTP ${response.statusCode}: ${response.data?.message || '请求失败'}`
                    };
                    reject(error);
                }
            },
            fail: (error: any) => {
                console.error(`请求失败 [${method}] ${fullUrl}:`, error);
                // 处理网络错误
                const errorMessage: string = error.errMsg || error.message || '网络请求失败';
                const uniError: UniRequestError = {
                    errMsg: errorMessage,
                    message: errorMessage
                };
                reject(uniError);
            }
        });
    });
};
// Token验证函数
export const validateToken = async (): Promise<any> => {
    try {
        const token: string = getToken();
        if (!token) {
            return { valid: false, reason: 'No token found' };
        }
        const response: any = await request({
            url: '/api/user/profile',
            method: 'GET',
            requireAuth: true,
            timeout: 5000
        });
        return { valid: true, user: response.data };
    }
    catch (error: any) {
        console.error('Token validation failed:', error);
        return {
            valid: false,
            reason: error.message || error.errMsg || 'Token validation failed'
        };
    }
};
