                if (response && response.code === 200 && response.data) {
                    const { token, user } = response.data;
                    console.log('登录成功，token已保存:', token.substring(0, 20) + '...');
                    // 保存用户信息到本地存储
                    uni.setStorageSync('current_user', JSON.stringify(user));
                    uni.showToast({
                        title: '登录成功',
                        icon: 'success',
                        mask: true,
                        duration: 1500
                    });
                    setTimeout(() => {
                        uni.navigateTo({
                            url: '/pages/index/index'
                        });
                    }, 1500);
                }
                else {
                    throw new Error('登录响应格式错误');
                }
            }
            catch (error: any) {
                console.error('登录失败:', error);
                const errorMsg = error?.message || '登录失败，请重试';
                uni.showToast({
                    title: errorMsg,
                    icon: 'none'
                });
            }
            finally {
                isLoading.value = false;
            }
        }
