import App from './App.uvue';
import { createSSRApp } from 'vue';
export function createApp(): UTSJSONObject {
    const app = createSSRApp(App);
    return {
        app
    };
}
// common/api/finance.ts
interface Transaction {
    amount: number;
    category: string;
    date: string;
}
export const addTransaction = (data: Transaction) => {
    return uni.request({ url: '/api/transaction', method: 'POST', data });
};
export function main(app: IApp) {
    definePageRoutes();
    defineAppConfig();
    (createApp()['app'] as VueApp).mount(app, GenUniApp());
}
export class UniAppConfig extends io.dcloud.uniapp.appframe.AppConfig {
    override name: string = "AI Financial Management";
    override appid: string = "__UNI__5A7011F";
    override versionName: string = "1.0.0";
    override versionCode: string = "100";
    override uniCompilerVersion: string = "4.64";
    constructor() { super(); }
}
