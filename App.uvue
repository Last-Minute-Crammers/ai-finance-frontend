<template>
  <view class="app-container">
    <router-view></router-view>
  </view>
</template>

<script>
import { testConnection, healthCheck, checkBackendConnection, setBackendUrl } from './utils/request.ts';

export default {
  async onLaunch() {
    console.log('App 启动');
    
    // 设置默认后端地址为localhost:8080
    setBackendUrl('http://localhost:8080');
    
    // 如果需要自定义后端地址，这里可以设置
    // setBackendUrl('http://192.168.1.100:8080'); // 例如连接到局域网中的服务器
    
    // 测试后端连接
    try {
      // 先进行基础连接检查
      const connectionCheck = await checkBackendConnection();
      console.log('Connection check result:', connectionCheck);
      
      // 判断检查结果是否有效
      if (connectionCheck && connectionCheck.connected) {
        console.log('Backend connection successful');
        
        // 连接成功后，再检查健康状态
        try {
          const healthStatus = await healthCheck();
          console.log('Backend health status:', healthStatus);
        } catch (healthError) {
          console.warn('Health check failed, but basic connection works:', healthError);
        }
      } else {
        // 提供诊断信息
        console.error('Backend connection failed:', connectionCheck?.error || '未知错误');
        console.info('Connection diagnostics:', connectionCheck?.diagnostics || {});
        
        // 显示连接失败提示，但不阻止应用启动
        uni.showModal({
          title: '后端连接失败',
          content: '无法连接到后端服务器，请确保服务已启动。\n\n您可以继续使用应用，但部分功能可能不可用。\n\n可前往【测试】页面调整后端地址。',
          showCancel: false
        });
      }
    } catch (error) {
      console.error('Failed to connect to backend:', error);
      // 显示连接失败提示，但不阻止应用启动
      uni.showModal({
        title: '连接失败',
        content: '无法连接到后端服务，请检查网络连接和服务器状态。\n\n错误详情: ' + 
          (typeof error === 'object' && error !== null && 'message' in error ? error.message : '未知错误'),
        showCancel: false
      });
    }
  },
  onShow() {
    console.log('App 显示');
  },
  onHide() {
    console.log('App 隐藏');
  }
}
</script>

<style>
.app-container {
  background-color: #f4f4f4;
  font-family: Arial, sans-serif;
  color: #333;
}
</style>
